# ── RiskcareHRMS backend environment ─────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
#
# You can connect either with a single connection string (Neon/Render style)…
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# …or with individual fields (used when DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Email (Brevo)
EMAIL_ENABLED=false
EMAIL_FROM=
BREVO_API_KEY=

# Runtime
NODE_ENV=development
PORT=5000
TZ=Asia/Kolkata
